# Coreboot configuration for PS4 Fat (CUH-1004A)

CONFIG_BOARD_SONY_PS4_FAT=y
CONFIG_VENDOR_SONY=y
CONFIG_BOARD_ROMSIZE_KB_2048=y

# CPU
CONFIG_MAX_CPUS=8
CONFIG_CPU_AMD_JAGUAR=y

# Northbridge
CONFIG_NORTHBRIDGE_AMD_PS4_BELIZE=y

# Southbridge
CONFIG_SOUTHBRIDGE_SONY_AEOLIA=y

# Console
CONFIG_CONSOLE_SERIAL=y
CONFIG_UART_FOR_CONSOLE=0
CONFIG_TTYS0_BASE=0xd0340000
CONFIG_TTYS0_BAUD=115200
CONFIG_CONSOLE_POST=y
CONFIG_SQUELCH_EARLY_SMP=y

# Payload
CONFIG_PAYLOAD_ELF=y
CONFIG_PAYLOAD_FILE="payloads/ps4_linux/ps4-linux.elf"

# Memory
CONFIG_DRAM_SIZE_MB=8192
CONFIG_CBFS_SIZE=0x200000

# PS4 specific
CONFIG_PS4_SUPPORT=y
CONFIG_PS4_AEOLIA=y
CONFIG_PS4_BELIZE=y
CONFIG_PS4_FIRMWARE_12XX=y

# Debug
CONFIG_GDB_STUB=y
CONFIG_DEBUG_SMI=y